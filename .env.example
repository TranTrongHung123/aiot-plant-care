# Copy to .env for local development; replace all change-me passwords.
COMPOSE_PROJECT_NAME=aiot-plant-care
POSTGRES_DB=plantcare
POSTGRES_USER=plantcare
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_PORT=5432
MINIO_ROOT_USER=plantcare-admin
MINIO_ROOT_PASSWORD=change-me-minio-root-password
MINIO_APP_USER=plantcare-app
MINIO_APP_PASSWORD=change-me-minio-app-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MQTT_LOCAL_PORT=1883

# Future backend settings: host processes use localhost, containers use service names.
APP_ENV=development
APP_TOKEN=change-me-demo-access-key
AI_PROVIDER=trained
# Đường dẫn tương đối từ thư mục gốc dự án; không tự chọn model mới nhất.
LEAF_MODEL_DIR=model-artifacts/leaf/mobilenetv3-20261015T031708_509896Z
FRUIT_MODEL_DIR=model-artifacts/fruit/full-20261015T040727_579719Z
WEATHER_MODEL_DIR=model-artifacts/weather/xgboost-20261015T035744_305966Z
# Cho phép thử nghiệm OpenWeather khác nguồn train Open-Meteo; chưa đánh giá domain shift.
WEATHER_ALLOW_DOMAIN_SHIFT=true
DEMO_MQTT_HOST=127.0.0.1
DEMO_MQTT_PORT=1883
DEVICE_MODE=simulation
POSTGRES_HOST=127.0.0.1
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_SECURE=false
MINIO_IMAGES_BUCKET=plant-images
MINIO_ARTIFACTS_BUCKET=ai-artifacts
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# HiveMQ Cloud (primary). Fill host and credentials from your cluster.
MQTT_HOST=
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=plantcare-backend-dev
MQTT_TOPIC_PREFIX=plantcare/v1/simulation

# Optional weather integration; never use made-up site coordinates.
OPENWEATHER_API_KEY=
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
